<header class="header">
  <div class="container-full">
    <div class="header__inner">
      <a href="/" class="header__logo">
        <img
          src="images/ico/logo.svg"
          width="56"
          height="52"
          alt="Jizerská 50"
        />
      </a>

      <nav class="headerNav">
        <ul class="headerNav__menu">
          <li class="headerNav__item js-menu-item">
            <button
              class="headerNav__link js-menu-toggle"
              type="button"
              aria-expanded="false"
            >
              Závody
              <img
                src="images/ico/chevron-down.svg"
                width="16"
                height="16"
                class="object-fit-contain"
                alt="ico"
              />
            </button>

            <div class="megaMenu">
              <div class="megaMenu__column megaMenu__column--featured">
                <div class="megaMenu__featured">
                  <a class="hover-underline-center fw-bold text-white" href="#"
                    >Přehled všech závodů</a
                  >
                  <div class="text-inverse-secondary fw-medium mx-auto">
                    Všechny ročníky a závody za 50 let
                  </div>
                </div>
              </div>

              <div class="megaMenu__divider"></div>

              <ul class="megaMenu__list">
                <li><a href="#">Jizerská 50 2027</a></li>
                <li><a href="#">Jizerská 30 2027</a></li>
                <li><a href="#">Jizerská 10 2027</a></li>
                <li><a href="#">Jizerská ČT 2027</a></li>
                <li><a href="#">Jizerská 5 2027</a></li>
                <li><a href="#">Jizerská 50 2027</a></li>
                <li><a href="#">Jizerská 50 2027</a></li>
              </ul>
            </div>
          </li>

          <li class="headerNav__item js-menu-item">
            <button
              class="headerNav__link js-menu-toggle"
              type="button"
              aria-expanded="false"
            >
              Výsledky
              <img
                src="images/ico/chevron-down.svg"
                width="16"
                height="16"
                class="object-fit-contain"
                alt="ico"
              />
            </button>

            <div class="megaMenu">
              <div class="megaMenu__column megaMenu__column--featured">
                <div class="megaMenu__featured">
                  <a class="hover-underline-center fw-bold text-white" href="#"
                    >Výsledky závodů</a
                  >
                </div>
              </div>

              <div class="megaMenu__divider"></div>

              <ul class="megaMenu__list">
                <li><a href="#">Klub mistrů</a></li>
                <li><a href="#">Král Jizerek</a></li>
              </ul>
            </div>
          </li>

          <li class="headerNav__item js-menu-item">
            <button
              class="headerNav__link js-menu-toggle"
              type="button"
              aria-expanded="false"
            >
              Praktické informace
              <img
                src="images/ico/chevron-down.svg"
                width="16"
                height="16"
                class="object-fit-contain"
                alt="ico"
              />
            </button>

            <div class="megaMenu">
              <ul class="megaMenu__list">
                <li><a href="#">Program</a></li>
                <li><a href="#">Doprava a parkování</a></li>
                <li><a href="#">Ubytování</a></li>
                <li><a href="#">Pro závodníky</a></li>
                <li><a href="#">Pro diváky</a></li>
                <li><a href="#">Jedlu poprvé</a></li>
              </ul>
            </div>
          </li>

          <li class="headerNav__item">
            <a href="#" class="headerNav__link"> Články </a>
          </li>

          <li class="headerNav__item js-menu-item">
            <button
              class="headerNav__link js-menu-toggle"
              type="button"
              aria-expanded="false"
            >
              Jizerská 50
              <img
                src="images/ico/chevron-down.svg"
                width="16"
                height="16"
                class="object-fit-contain"
                alt="ico"
              />
            </button>

            <div class="megaMenu">
              <ul class="megaMenu__list">
                <li><a href="#">O Jizerské 50</a></li>
                <li><a href="#">Historie</a></li>
                <li><a href="#">Charita</a></li>
                <li><a href="#">Komunita</a></li>
                <li><a href="#">Partneři</a></li>
              </ul>
            </div>
          </li>

          <li class="headerNav__item">
            <a href="#" class="headerNav__link">Eshop</a>
          </li>

          <li class="headerNav__item js-menu-item">
            <button
              class="headerNav__link js-menu-toggle"
              type="button"
              aria-expanded="false"
            >
              Kontakt
              <img
                src="images/ico/chevron-down.svg"
                width="16"
                height="16"
                class="object-fit-contain"
                alt="ico"
              />
            </button>

            <div class="megaMenu">
              <ul class="megaMenu__list">
                <li><a href="#">Kontakty</a></li>
                <li><a href="#">Členská sekce</a></li>
              </ul>
            </div>
          </li>
        </ul>
        <!-- <div class="mobileFooter">
          <a href="#" class="mobileFooter__register">
            <span class="mobileFooter__icon">ID</span>
            REGISTROVAT SE
          </a>

          <a href="#" class="mobileFooter__next">
            <span></span>
          </a>

          <button class="mobileFooter__language" type="button">
            CS
            <span></span>
          </button>
        </div> -->
      </nav>

      <div class="headerActions">
        <a href="#" class="button-secondary py-1 d-xxl-flex d-none">
          <img src="images/ico/sportid.svg" alt="id" />
          Registrovat se
        </a>

        <details class="headerActions__language d-xl-flex d-none">
          <summary class="d-flex align-items-center gap-1">
            CS
            <img
              src="images/ico/chevron-down.svg"
              width="16"
              height="16"
              class="object-fit-contain"
              alt="ico"
            />
          </summary>
          <ul class="headerActions__language-list">
            <li>
              <a class="active" href="#">CS</a>
            </li>
            <li>
              <a href="#">EN</a>
            </li>
            <li>
              <a href="#">DE</a>
            </li>
          </ul>
        </details>

        <button
          class="headerActions__icon js-search-open"
          type="button"
          aria-label="Hledat"
        >
          {% include "@images/search.svg" %}
        </button>

        <a href="#" class="headerActions__icon" aria-label="Počasí">
          {% include "@images/weather.svg" %}
        </a>

        <a href="#" class="headerActions__icon d-xl-none">
          {% include "@images/insta.svg" %}
        </a>

        <a href="#" class="headerActions__icon d-xl-none">
          {% include "@images/fb.svg" %}
        </a>

        <button
          class="headerActions__menu js-nav-toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
        >
          <img
            class="headerActions__menu-icon headerActions__menu-icon--open"
            src="images/ico/menu.svg"
            width="24"
            height="24"
            alt=""
          />

          <img
            class="headerActions__menu-icon headerActions__menu-icon--close"
            src="images/ico/close.svg"
            width="24"
            height="24"
            alt=""
          />
        </button>
      </div>
    </div>
  </div>

  <div class="headerSearch js-search">
    <form class="headerSearch__form">
      <button class="headerSearch__btn" type="submit">
        <img src="images/ico/search-primary.svg" alt="" />
      </button>

      <input
        class="headerSearch__input"
        type="search"
        placeholder="Hledat informace"
      />
    </form>

    <div class="headerSearch__section">
      <div class="headerSearch__title">Často hledané</div>

      <ul class="headerSearch__list">
        <li>
          <a href="#">
            <img src="images/ico/search-secondary.svg" alt="" />
            Registrace
          </a>
        </li>
        <li>
          <a href="#">
            <img src="images/ico/search-secondary.svg" alt="" />
            Přeregistrace
          </a>
        </li>
        <li>
          <a href="#">
            <img src="images/ico/search-secondary.svg" alt="" />
            Výdej čísel
          </a>
        </li>
        <li>
          <a href="#">
            <img src="images/ico/search-secondary.svg" alt="" />
            Doprava
          </a>
        </li>
        <li>
          <a href="#">
            <img src="images/ico/search-secondary.svg" alt="" />
            Parkování
          </a>
        </li>
        <li>
          <a href="#">
            <img src="images/ico/search-secondary.svg" alt="" />
            Pravidla závodu
          </a>
        </li>
      </ul>
    </div>

    <div class="headerSearch__section">
      <div class="headerSearch__title">Naposledy navštíveno</div>

      <ul class="headerSearch__list">
        <li>
          <a href="#">
            <img src="images/ico/clock.svg" alt="" />
            Jizerská 50
          </a>
        </li>
        <li>
          <a href="#">
            <img src="images/ico/clock.svg" alt="" />
            Jizerská 25
          </a>
        </li>
        <li>
          <a href="#">
            <img src="images/ico/clock.svg" alt="" />
            Kontakty
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>
