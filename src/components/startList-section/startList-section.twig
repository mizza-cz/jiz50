<section class="startList">
  <div class="container">
    <form
      class="d-flex flex-wrap align-items-center position-relative gap-md-3 gap-2 mb-3"
    >
      <div class="formSelect formSelect--multiple">
        <select
          class="js-select"
          name="players[]"
          multiple
          data-placeholder="Hledat závodníka"
          data-search-placeholder="Začněte psát"
        >
          <option value="1">Jan Novák</option>
          <option value="2">Petr Svoboda</option>
          <option value="3">Martin Dvořák</option>
          <option value="4">Tomáš Černý</option>
          <option value="5">Lukáš Procházka</option>
        </select>
      </div>

      <div class="formSelect">
        <select class="js-select" name="race" data-placeholder="Vyberte závod">
          <option></option>
          <option value="50">Jizerská 50 | 2026</option>
          <option value="25">Jizerská 25 | 2026</option>
          <option value="10">Jizerská 10 | 2026</option>
        </select>
      </div>
    </form>
    <div class="o-content mb-lg-18 mb-12">
      <table class="">
        <thead>
          <tr>
            <th>Vlna</th>
            <th>Jméno</th>
            <th>Rok Nar.</th>
            <th>Závod</th>
            <th>Klub</th>
            <th class="text-end">Zaplaceno</th>
          </tr>
        </thead>

        <tbody>
          {% for i in 1..18 %}
          <tr>
            <td>
              {{ (loop.index % 4) + 1 }}
            </td>

            <td class="fw-extrabold">Johanes Tjelle</td>

            <td>1975</td>

            <td>ČEZ Jizerská 50</td>

            <td>Klub 1</td>

            <td class="text-end">
              <img
                src="images/ico/check.svg"
                width="24"
                height="24"
                class="object-fit-contain d-inline"
                alt="Zaplaceno"
              />
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div
      class="d-flex gap-3 align-items-center justify-content-center flex-column"
    >
      <div class="text-secondary fw-medium text-center">
        Výsledky 1–20 z 240
      </div>
      <button class="button-secondary">Načíst další výsledky</button>
    </div>
  </div>
</section>
