<section class="hero swiper">
  <div class="swiper-wrapper">
    <div class="swiper-slide hero__slide">
      <picture class="hero__bg">
        <source
          media="(max-width: 767.98px)"
          srcset="https://picsum.photos/id/10/768/900"
        />

        <img
          src="https://picsum.photos/id/10/1920/830"
          srcset="
            https://picsum.photos/id/10/1920/830  1x,
            https://picsum.photos/id/10/2560/1107 2x
          "
          width="1920"
          height="830"
          alt=""
        />
      </picture>

      <div class="hero__overlay"></div>

      <div class="container hero__container">
        <div class="hero__content">
          <div class="tag-tertiary mb-2">Registrace otevřena</div>

          <h1 class="h1 mb-3">Legenda, která spojuje generace</h1>

          <div class="subtitle-primary text-inverse-secondary">
            Jizerská 50 / 2027
          </div>

          <a href="#" class="button-primary button-primary--arrow mt-3">
            <span>Přidat se na start</span>

            <span class="button-primary__arrow">
              {% include "@images/arrow-right.svg" %}
            </span>
          </a>
        </div>
      </div>
    </div>

