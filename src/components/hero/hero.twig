  <div class="hero__static">
    <div class="container">
      <ul class="hero__partners">
        <li>
          <img src="images/content/hero-1.png" alt="ČEZ" />
        </li>

        <li>
          <img src="images/content/hero-2.png" alt="Ski Classics" />
        </li>

        <li>
          <img src="images/content/hero-3.png" alt="Raul" />
        </li>
      </ul>

      <div class="hero__pagination">
        <button
          class="hero__pagination-item"
          type="button"
          data-slide="0"
          aria-label="Slide 1"
        >
          <span class="hero__pagination-progress"></span>
        </button>

        <button
          class="hero__pagination-item"
          type="button"
          data-slide="1"
          aria-label="Slide 2"
        >
          <span class="hero__pagination-progress"></span>
        </button>

        <button
          class="hero__pagination-item"
          type="button"
          data-slide="2"
          aria-label="Slide 3"
        >
          <span class="hero__pagination-progress"></span>
        </button>

        <button
          class="hero__pagination-item"
          type="button"
          data-slide="3"
          aria-label="Slide 4"
        >
          <span class="hero__pagination-progress"></span>
        </button>
      </div>

      <div class="hero__info">
        <div class="fw-extrabold">Jizerky zasypal sníh! A pořádně.</div>
        <div class="text-medium-sm text-secondary">
          Sledujte aktuální podmínky
        </div>
      </div>
    </div>
  </div>
</section>
