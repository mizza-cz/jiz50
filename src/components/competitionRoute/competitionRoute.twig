<section class="competitionRoute">
  <div class="container">
    <div class="competitionRoute__top">
      <div class="competitionRoute__info">
        <div class="subtitle-secondary mb-2">TRASA</div>

        <h2 class="h2 mb-lg-8">Poznej každý kilometr</h2>

        <ul class="d-lg-grid d-none gap-8">
          <li class="d-grid gap-2">
            <span class="subtitle-secondary">Délka trasy</span>
            <span class="h5">50,6 km</span>
          </li>
          <li class="d-grid gap-2">
            <span class="subtitle-secondary">Převýšení</span>
            <span class="h5">↑ 890 m</span>
          </li>
          <li class="d-grid gap-2">
            <span class="subtitle-secondary">Nejvyšší bod</span>
            <span class="h5">1 226 m</span>
          </li>
          <li class="d-grid gap-2">
            <span class="subtitle-secondary">Občerstvení</span>
            <span class="h5">12x</span>
          </li>
        </ul>
      </div>

      <div class="competitionRoute__map">
        <div
          id="map_competition"
          class="competitionRoute__mapCanvas js-route-map"
        ></div>

        <div class="d-none">
          <div id="route-map-arrow">
            <svg width="26" height="26" viewBox="0 0 105 105">
              <path
                d="m50.76 80.22-34.71 19.82a3.708 3.708 41.64 0 1-5.252-4.669l37.39-88.05a4.671 4.671 6.678e-6 0 1 8.6 1e-6l37.39 88.05a3.708 3.708 138.4 0 1-5.252 4.669l-34.71-19.82a3.502 3.502 7.994e-6 0 0-3.473 0z"
                fill="#fff"
                stroke="currentColor"
                stroke-linejoin="round"
                stroke-width="5"
              />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="competitionRoute__profile">
    <div class="container">
      <div class="d-flex align-items-center mb-4 justify-content-between">
        <div class="subtitle-secondary">VÝŠKOVÝ PROFIL ZÁVODU</div>
        <img
          src="images/ico/arrow-right.svg"
          width="24"
          height="24"
          class="object-fit-contain d-lg-none"
          alt="arrow"
        />
      </div>
    </div>

    <div class="competitionRoute__profileScroll">
      <div class="competitionRoute__profileImage">
        <img
          src="images/content/profil-zavodu.png"
          alt="Výškový profil závodu Jizerská 50"
        />
      </div>
    </div>
  </div>
</section>
