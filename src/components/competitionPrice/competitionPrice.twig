<section class="competitionPrice py-xl-20 py-lg-15 py-4">
  <div class="container-lg">
    <div class="d-lg-flex justify-content-between align-items-center gap-6">
      <div class="competitionPrice__content">
        <div class="subtitle-secondary">REGISTRACE 2026</div>

        <h2 class="h2 mb-4">Rezervuj si místo na startu</h2>

        <p class="text-medium-sm mb-4 text-inverse-secondary">
          Kapacita závodu je omezená. Závodníci, kteří se přihlásí do 31. října,
          mají navíc jméno vytištěné na startovním čísle - a šetří stovky korun.
        </p>

        <p class="text-medium-sm mb-4 text-inverse-secondary">
          Online registrace probíhá přes SportID. Skupinové přihlášení pro
          kluby, firmy a školy vyřiďte e-mailem na
          <a class="text-tertiary" href="mailto:info@jiz50.cz">info@jiz50.cz</a>
        </p>

        <div class="competitionPrice__status d-lg-none">
          <img
            src="images/ico/status.svg"
            width="34"
            height="34"
            class="object-fit-contain"
            alt="ico"
          />
          <span>Jizerská 50 je dokončená</span>
        </div>

        <a
          href="#"
          class="button-primary button-primary--arrow d-none d-lg-flex"
        >
          <span>
            {% include "@images/external-link.svg" %} Přidej se na start
          </span>

          <span class="button-primary__arrow">
            {% include "@images/arrow-right.svg" %}
          </span>
        </a>
      </div>

      <div
        class="d-flex flex-sm-row flex-column gap-6 w-100 justify-content-end"
      >
        <article class="competitionPriceCard">
          <div class="competitionPriceCard__head bg-accent">
            <div class="caption mb-1">Vlajkový závod</div>

            <div class="fw-extrabold">ČEZ Jizerská 50</div>
          </div>

          <div class="competitionPriceCard__body">
            <div class="competitionPriceCard__row">
              <span>Do</span>
              <span>Cena</span>
            </div>

            <div class="competitionPriceCard__row">
              <span class="fw-extrabold text-white">31.8.2026</span>
              <span class="fw-extrabold text-green">2 359 Kč</span>
            </div>

            <div class="competitionPriceCard__row">
              <span>30.9.2026</span>
              <span>2 659 Kč</span>
            </div>

            <div class="competitionPriceCard__row">
              <span>31.10.2026</span>
              <span>2 959 Kč</span>
            </div>

            <div class="competitionPriceCard__row">
              <span>30.11.2026</span>
              <span>3 259 Kč</span>
            </div>
          </div>
        </article>

        <article class="competitionPriceCard">
          <div class="competitionPriceCard__head bg-tertiary">
            <div class="caption mb-1">Sobotní závod</div>

            <div class="fw-extrabold">ČEZ Jizerská 25</div>
          </div>

          <div class="competitionPriceCard__body">
            <div class="competitionPriceCard__row">
              <span>Do</span>
              <span>Cena</span>
            </div>

            <div class="competitionPriceCard__row">
              <span class="fw-extrabold text-white">31.8.2026</span>
              <span class="fw-extrabold text-green">2 359 Kč</span>
            </div>

            <div class="competitionPriceCard__row">
              <span>30.9.2026</span>
              <span>2 659 Kč</span>
            </div>

            <div class="competitionPriceCard__row">
              <span>31.10.2026</span>
              <span>2 959 Kč</span>
            </div>

            <div class="competitionPriceCard__row">
              <span>30.11.2026</span>
              <span>3 259 Kč</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
