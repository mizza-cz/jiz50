"T-Mobile Jizerská firemní štafeta" ] %} {% set routeStats = [ { label: "Celkové
převýšení", value: "762 m" }, { label: "Nejnižší bod", value: "738 m.n.m" }, {
label: "Maximální stoupání", value: "10,9 %" }, { label: "Maximální klesání",
value: "-9,3 %" }, { label: "Nejvyšší bod", value: "1002 m.n.m" }, { label:
"Celková délka závodu", value: "50,6 km" } ] %} {% set routes = [ "ČEZ Jizerská
50", "Volkswagen Bedřichovská 30", "ČRA Jizerská 25", "VINCI Construction
Jizerská 17", "ORLEN Sprint", "ČT Jizerská 10", "T-Mobile Jizerská firemní
štafeta" ] %} {% set routeStats = [ { label: "Celkové převýšení", value: "762 m"
}, { label: "Nejnižší bod", value: "738 m.n.m" }, { label: "Maximální stoupání",
value: "10,9 %" }, { label: "Maximální klesání", value: "-9,3 %" }, { label:
"Nejvyšší bod", value: "1002 m.n.m" }, { label: "Celková délka závodu", value:
"50,6 km" } ] %}

<section class="mapsPage">
  <div class="container">
    {# DESKTOP FILTER #}

    <div class="d-none d-lg-block">
      <form class="mb-6">
        <div class="formSelect">
          <select class="js-select" name="race" data-placeholder="Závod">
            <option></option>
            <option value="j50" selected>Jizerská 50 | 2026</option>
            <option value="j25">Jizerská 25</option>
            <option value="b30">Bedřichovská 30</option>
            <option value="j17">Jizerská 17</option>
          </select>
        </div>
      </form>
    </div>

    {# MOBILE #}

    <div class="resultsPage__mobile d-lg-none">
      <div class="resultsPage__mobileTop">
        <div class="resultsPage__mobileControls">
          <div class="formSelect formSelect--fluid">
            <select
              class="js-select"
              name="race-mobile"
              data-placeholder="Závod"
            >
              <option></option>
              <option value="j50" selected>Jizerská 50</option>
              <option value="j25">Jizerská 25</option>
              <option value="b30">Bedřichovská 30</option>
              <option value="j17">Jizerská 17</option>
            </select>
          </div>

          <button
            class="resultsPage__filterButton js-results-filter"
            type="button"
            aria-expanded="false"
            aria-controls="results-mobile-filter"
            aria-label="Otevřít filtr"
          >
            <img src="images/ico/filter.svg" width="24" height="24" alt="" />
          </button>
        </div>
      </div>

      <div class="resultsPage__mobileList">
        {% for item in results %}
        <div class="resultsPageMobileRow {% if loop.first %}is-open{% endif %}">
          <button
            class="resultsPageMobileRow__toggle js-results-row"
            type="button"
            aria-expanded="{{ loop.first ? 'true' : 'false' }}"
          >
            <span class="resultsPageMobileRow__place">
              {{ loop.index }}
            </span>

            <span class="resultsPageMobileRow__name">
              {{ item.name }}
            </span>

            <span class="resultsPageMobileRow__time">
              {{ item.time }}
            </span>

            <span class="resultsPageMobileRow__chevron">
              {% include "@images/chevron-down.svg" %}
            </span>
          </button>

          <div class="resultsPageMobileRow__content">
            <div class="resultsPageMobileRow__contentInner">
              <div class="resultsPageMobileRow__stat">
                <span>Statistika 1</span>
                <strong>38,3 km/h</strong>
              </div>

              <div class="resultsPageMobileRow__stat">
                <span>Úsek 1</span>
                <strong>12:34</strong>
              </div>

              <div class="resultsPageMobileRow__stat">
                <span>Úsek 2</span>
                <strong>12:34</strong>
              </div>

              <div class="resultsPageMobileRow__actions">
                <a href="#" class="resultsPageMobileRow__action">
                  <img src="images/ico/lev.svg" width="24" height="24" alt="" />

                  <span> Analýza výsledků Generali Investments </span>

                  {% include "@images/external-link.svg" %}
                </a>

                <a
                  href="../files/diplom.pdf"
                  download
                  class="resultsPageMobileRow__action"
                >
                  <img
                    src="images/ico/download.svg"
                    width="24"
                    height="24"
                    alt=""
                  />

                  <span>Stáhnout diplom</span>
                </a>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>

      {# FILTER PANEL #}

      <div
        class="resultsPageFilter js-results-mobile-filter"
        id="results-mobile-filter"
        aria-hidden="true"
      >
        <div class="resultsPageFilter__header">
          <strong>Filtr</strong>

          <button
            class="resultsPageFilter__close js-results-filter-close"
            type="button"
            aria-label="Zavřít filtr"
          >
            {% include "@images/close.svg" %}
          </button>
        </div>

        <form class="resultsPageFilter__form">
          <div class="resultsPageFilter__body">
            <div class="resultsPageFilter__group">
              <h3 class="resultsPageFilter__title">Ročník</h3>

              <div class="resultsPageFilter__range">
                <label class="resultsPageFilter__rangeField">
                  <span>Od</span>

                  <input type="text" name="year-from" />
                </label>

                <label class="resultsPageFilter__rangeField">
                  <span>Do</span>

                  <input type="text" name="year-to" />
                </label>
              </div>

              <div class="resultsPageFilter__options">
                <label class="resultsPageFilter__radio">
                  <input type="radio" name="year-filter" value="2026" />

                  <span></span>

                  2026
                </label>

                <label class="resultsPageFilter__radio">
                  <input type="radio" name="year-filter" value="2025" />

                  <span></span>

                  2025
                </label>

                <label class="resultsPageFilter__radio">
                  <input type="radio" name="year-filter" value="2024" />

                  <span></span>

                  2024
                </label>
              </div>

              <button class="resultsPageFilter__more" type="button">
                + dalších 38 {% include "@images/chevron-down.svg" %}
              </button>
            </div>

            <div class="resultsPageFilter__group">
              <h3 class="resultsPageFilter__title">Věková kategorie</h3>

              <div class="resultsPageFilter__options">
                <label class="resultsPageFilter__radio">
                  <input type="radio" name="age-filter" value="18-30" />

                  <span></span>

                  18 - 30
                </label>

                <label class="resultsPageFilter__radio">
                  <input type="radio" name="age-filter" value="31-50" />

                  <span></span>

                  31 - 50
                </label>

                <label class="resultsPageFilter__radio">
                  <input type="radio" name="age-filter" value="51-70" />

                  <span></span>

                  51 - 70
                </label>

                <label class="resultsPageFilter__radio">
                  <input type="radio" name="age-filter" value="71-90" />

                  <span></span>

                  71 - 90+
                </label>
              </div>
            </div>

            <div class="resultsPageFilter__group">
              <h3 class="resultsPageFilter__title">Pohlaví</h3>

              <div class="resultsPageFilter__options">
                <label class="resultsPageFilter__radio">
                  <input type="radio" name="gender-filter" value="male" />

                  <span></span>

                  Muž
                </label>

                <label class="resultsPageFilter__radio">
                  <input type="radio" name="gender-filter" value="female" />

                  <span></span>

                  Žena
                </label>
              </div>
            </div>
          </div>

          <div class="resultsPageFilter__footer">
            <button
              class="button-primary resultsPageFilter__submit"
              type="submit"
            >
              Zobrazit výsledky
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="mapsPage__head">
      <div>
        <div class="subtitle-secondary mb-2">Trasa</div>

        <h2 class="h2 mb-0">Jizerská 50</h2>
      </div>
    </div>

    <div class="mapsPage__content">
      <div class="mapsPage__info">
        <div class="subtitle-secondary mb-4">Údaje</div>

        <div class="mapsPage__stats">
          {% for stat in routeStats %}
          <div class="mapsPage__stat">
            <span class="mapsPage__statValue">
              {{ stat.value }}
            </span>

            <span class="mapsPage__statLabel">
              {{ stat.label }}
            </span>
          </div>
          {% endfor %}
        </div>

        <div class="mapsPage__downloads">
          <div class="subtitle-secondary mb-3">Ke stažení</div>

          <a
            href="../files/jizerska-50.kml"
            download
            class="mapsPage__download"
          >
            <span> Keyhole Markup Language </span>

            <span class="mapsPage__downloadType"> KML </span>

            <img src="images/ico/download.svg" width="24" height="24" alt="" />
          </a>

          <a
            href="../files/jizerska-50.gpx"
            download
            class="mapsPage__download"
          >
            <span> GPS eXchange Format </span>

            <span class="mapsPage__downloadType"> GPX </span>

            <img src="images/ico/download.svg" width="24" height="24" alt="" />
          </a>
        </div>
      </div>

      <div class="mapsPage__map">
        <div id="map_j50" class="mapsPage__mapCanvas js-route-map"></div>

        <div class="d-none">
          <div id="route-map-arrow">
            <svg width="26" height="26" viewBox="0 0 105 105">
              <path
                d="m50.76 80.22-34.71 19.82a3.708 3.708 41.64 0 1-5.252-4.669l37.39-88.05a4.671 4.671 6.678e-6 0 1 8.6 1e-6l37.39 88.05a3.708 3.708 138.4 0 1-5.252 4.669l-34.71-19.82a3.502 3.502 7.994e-6 0 0-3.473 0z"
                fill="#fff"
                stroke="currentColor"
                stroke-linejoin="round"
                stroke-width="5"
              />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mapsPage__profile">
    <div class="container">
      <div class="mapsPage__profileHead">
        <div class="subtitle-secondary">Výškový profil závodu</div>

        <img
          src="images/ico/arrow-right.svg"
          width="24"
          height="24"
          class="d-lg-none"
          alt=""
        />
      </div>
    </div>

    <div class="mapsPage__profileScroll">
      <div class="mapsPage__profileImage">
        <img
          src="images/content/profil-zavodu.png"
          alt="Výškový profil závodu Jizerská 50"
        />
      </div>
    </div>
  </div>
</section>
